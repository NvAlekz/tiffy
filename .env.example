# 1. Copia este archivo como .env.local
# 2. Rellena los valores desde Firebase Console > Configuración del proyecto > Tus apps > SDK setup.
# 3. Reinicia `npm run dev` (o vuelve a compilar con `npm run build`).

VITE_FIREBASE_API_KEY=tu-api-key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
